Host github.com
    User git
    # No IdentityFile: ssh's defaults cover the desktop (id_rsa) and laptop (id_ed25519)
    # keys, and unlike an explicit IdentityFile a missing default key does not warn.
    AddKeysToAgent yes

Host github-hooxen
    HostName github.com
    User git
    IdentityFile ~/.ssh/hooxen_github_ed25519
    IdentitiesOnly yes
