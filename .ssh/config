Host github.com
    User git
    # Desktop key first, laptop key second; ssh silently skips whichever is absent.
    IdentityFile ~/.ssh/id_rsa
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes

Host github-hooxen
    HostName github.com
    User git
    IdentityFile ~/.ssh/hooxen_github_ed25519
    IdentitiesOnly yes
