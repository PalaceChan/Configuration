{
    "$schema": "https://eca.dev/config.json",
    "defaultModel": "anthropic/claude-opus-5-5",
    "chat": {
        "defaultTrust": true
    },
    "providers": {
        "openrouter": {
            "api": "openai-chat",
            "url": "https://openrouter.ai/api/v1",
            "fetchModels": false,
            "models": {
                "deepseek/deepseek-v4-flash":   { "limit": { "context": 1048576, "output": 128000 } },
                "deepseek/deepseek-v4-pro":     { "limit": { "context": 1048576, "output": 128000 } },
                "deepseek/deepseek-v4.1-flash": { "limit": { "context": 1048576, "output": 128000 } },
                "z-ai/glm-5.3":                 { "limit": { "context": 1310720, "output": 128000 } },
                "x-ai/grok-4.5":                { "limit": { "context": 500000,  "output": 128000 } },
                "x-ai/grok-4.6":                { "limit": { "context": 500000,  "output": 128000 } },
                "x-ai/grok-4.7":                { "limit": { "context": 500000,  "output": 128000 } },
                "moonshotai/kimi-k3":           { "limit": { "context": 1048576, "output": 128000 } }
            }
        }
    },
    "prompts": {
        "tools": {
            "eca__git": "${file:/home/avelazqu/.config/eca/prompts/tools/git.md}"
        }
    },
    "toolCall": {
        "approval": {
            "byDefault": "allow"
        }
    }
}
